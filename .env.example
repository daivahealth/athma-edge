# ──────────────────────────────────────────────
# Athma Edge — BCP Application Environment
# Copy to .env and replace every REPLACE_* value before first run.
#
# Five variables have no default and the stack refuses to start without them:
#   POSTGRES_PASSWORD  JWT_SECRET  DEFAULT_TENANT_ID  N8N_PASSWORD
#   PGADMIN_PASSWORD   (docker-compose.dev.yml only)
# ──────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=bcpuser
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=athma_edge

# Backend API
# Host port is 5433 (see docker-compose.yml). Inside the stack it is postgres:5432.
DATABASE_URL=postgresql://bcpuser:REPLACE_WITH_STRONG_POSTGRES_PASSWORD@localhost:5433/athma_edge?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRY=8h
BCRYPT_ROUNDS=12
DEFAULT_TENANT_ID=REPLACE_WITH_HOSPITAL_TENANT_ID
PDF_STORAGE_PATH=./local-bcp-storage/pdfs

# Port the API listens on inside its container.
PORT=3100
# Host port the stack publishes. The API serves both /api and the SPA on it.
# Change this if something else owns 80, or if you put a proxy in front.
HTTP_PORT=80
# The externally visible origin, used for CORS. Behind a TLS proxy this is the
# https:// address staff type, not localhost. See docs/deployment/REVERSE-PROXY.md.
FRONTEND_ORIGIN=http://localhost:3000   # :3000 for the Vite dev server
API_DOCS_ENABLED=false

# Optional bootstrap password for the first seed run.
# If omitted, the seed script generates a random password and prints it once.
ADMIN_BOOTSTRAP_PASSWORD=

# Site timezone. n8n evaluates cron/schedule triggers against it, and without
# it n8n falls back to America/New_York — every scheduled sync then fires at
# the wrong local time with nothing in the logs to say so.
TZ=Asia/Kolkata

# Frontend
# The SPA is built into the API image and served by it on a relative /api
# path, so it needs no build-time or runtime API URL.
# SPA_ROOT overrides where the API looks for the bundle; the default is
# `public/` beside the compiled server and is right for the Docker image.
# SPA_ROOT=

# NODE_ENV is set to production by the runtime image. It does not control the
# session cookie's Secure flag — that follows the request scheme.

# n8n
N8N_USER=admin
N8N_PASSWORD=REPLACE_WITH_STRONG_N8N_PASSWORD

# pgAdmin (docker-compose.dev.yml only, but PGADMIN_PASSWORD is required there)
PGADMIN_EMAIL=admin@athmaedge.dev
PGADMIN_PASSWORD=REPLACE_WITH_STRONG_PGADMIN_PASSWORD
