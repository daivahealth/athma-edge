# ──────────────────────────────────────────────
# Athma Edge — BCP Application Environment
# Copy to .env and update values for your setup
# ──────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=bcpuser
POSTGRES_PASSWORD=bcppass
POSTGRES_DB=athma_edge

# Backend API
# Use port 5433 for local dev (docker-compose.dev.yml), 5432 for production
DATABASE_URL=postgresql://bcpuser:bcppass@localhost:5433/athma_edge?schema=public
JWT_SECRET=change-me-in-production
JWT_EXPIRY=8h
BCRYPT_ROUNDS=12
DEFAULT_TENANT_ID=DEFAULT
PDF_STORAGE_PATH=./local-bcp-storage/pdfs
PORT=3100

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3100

# n8n
N8N_USER=admin
N8N_PASSWORD=n8nAdmin@2024

# pgAdmin (dev only)
PGADMIN_EMAIL=admin@athmaedge.dev
PGADMIN_PASSWORD=pgadmin
