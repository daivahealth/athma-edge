# ──────────────────────────────────────────────
# Athma Edge — BCP Application Environment
# Copy to .env and replace every REPLACE_* value before first run
# ──────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=bcpuser
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=athma_edge

# Backend API
# Use port 5433 for local dev (docker-compose.dev.yml), 5432 for production
DATABASE_URL=postgresql://bcpuser:REPLACE_WITH_STRONG_POSTGRES_PASSWORD@localhost:5433/athma_edge?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRY=8h
BCRYPT_ROUNDS=12
DEFAULT_TENANT_ID=REPLACE_WITH_HOSPITAL_TENANT_ID
PDF_STORAGE_PATH=./local-bcp-storage/pdfs
PORT=3100
FRONTEND_ORIGIN=http://localhost:3000   # :3000 for the Vite dev server; http://localhost for the nginx stack
API_DOCS_ENABLED=false

# Optional bootstrap password for first seed run.
# If omitted, the seed script generates a random password and prints it once.
ADMIN_BOOTSTRAP_PASSWORD=

# Frontend
# The SPA is served by nginx and calls the API on a relative /api path,
# so it needs no build-time or runtime API URL.

# n8n
N8N_USER=admin
N8N_PASSWORD=REPLACE_WITH_STRONG_N8N_PASSWORD

# pgAdmin (dev only)
PGADMIN_EMAIL=admin@athmaedge.dev
PGADMIN_PASSWORD=REPLACE_WITH_STRONG_PGADMIN_PASSWORD
